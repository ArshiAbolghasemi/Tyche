# ── Tyche configuration — copy to .env and edit ──────────────────────────────
# Every value has a sensible default; only override what you need. Lists are
# comma-separated (or a JSON array). Booleans: 1/true/yes/on.

# Deployment profile: development | staging | production
TYCHE_ENV=development

# HuggingFace — OPTIONAL. Summarizer/Embedder now load weights locally (no hosted
# InferenceClient calls), so this is unused for public models like bart-large-cnn /
# bge-m3; set it only if you switch to a gated/private model or want a higher
# rate limit on the (unauthenticated-by-default) revision lookup.
HF_TOKEN=

# ── Paths ────────────────────────────────────────────────────────────────────
# Source news feed. Two shapes are supported (see tyche/news/agents/ingest.py):
# rl2k — id/symbol/ticker/date/snippet/Description, already one row per
# (article, ticker); zanista — title/content articles with a multi-value
# ``symbols`` column to explode.
TYCHE_PATHS_INPUT=data/rl2k/news.parquet
TYCHE_PATHS_OUTPUT=data/output/news_sentiment.parquet

# ── Ingest ───────────────────────────────────────────────────────────────────
TYCHE_INGEST_GROUP_KEY_COLS=exchange,type
TYCHE_INGEST_MASKED_PLACEHOLDER=the company

# ── Summarizer (facebook/bart-large-cnn, loaded locally onto DEVICE) ─────────
# device: cpu | cuda | cuda:N | mps | auto (auto picks CUDA > MPS > CPU)
# max_length bumped to 512: the summary now feeds bge-m3 (8192-token context) and an
# LLM sentiment scorer, so it no longer has to fit FinBERT's old 512-token window.
TYCHE_SUMMARIZER_DEVICE=autodynaconf
TYCHE_SUMMARIZER_BATCH_SIZE=8
TYCHE_SUMMARIZER_MAX_LENGTH=512
TYCHE_SUMMARIZER_MIN_LENGTH=80

# ── Embedder (BAAI/bge-m3, loaded locally onto DEVICE) ───────────────────────
# Summaries are embedded here so the Deduplicator can cluster near-duplicate stories.
# device: cpu | cuda | cuda:N | mps | auto (auto picks CUDA > MPS > CPU)
TYCHE_EMBEDDING_NAME=BAAI/bge-m3
TYCHE_EMBEDDING_REVISION=main
TYCHE_EMBEDDING_DEVICE=auto
TYCHE_EMBEDDING_MAX_TOKENS=8192
TYCHE_EMBEDDING_BATCH_SIZE=32

# ── Deduplicator ─────────────────────────────────────────────────────────────
# Cosine-distance threshold for monthly agglomerative clustering (lower ⇒ stricter);
# window is a pandas period-frequency alias ("M" = calendar month).
TYCHE_DEDUP_DISTANCE_THRESHOLD=0.15
TYCHE_DEDUP_WINDOW=M

# ── Sentiment scorer — backend selection ─────────────────────────────────────
# Comma-separated list of backends the Scorer runs, in order (see
# tyche/news/service/sentiment.py). Choices: gpt4o_mini | finbert |
# mistral_7b_instruct | llama2_13b_chat. The FIRST entry is the "primary" backend —
# its output also populates the canonical unprefixed columns (agg_p_pos, raw_score,
# ...) that the Neutralizer/Auditor/output-contract consume. Every backend
# (primary included) additionally gets its own <backend>_-prefixed columns, so
# running more than one lets you compare them side by side.
TYCHE_SENTIMENT_BACKENDS=gpt4o_mini

# ── gpt4o_mini (Azure OpenAI gpt-4.0-mini via LangChain) ─────────────────────
# REQUIRED if gpt4o_mini is in TYCHE_SENTIMENT_BACKENDS (never commit a real key).
TYCHE_SENTIMENT_AZURE_API_KEY=
TYCHE_SENTIMENT_AZURE_ENDPOINT=https://zanistagpteastus2.openai.azure.com
TYCHE_SENTIMENT_AZURE_DEPLOYMENT=gpt-4o-mini
TYCHE_SENTIMENT_AZURE_API_VERSION=2024-12-01-preview
TYCHE_SENTIMENT_AZURE_TEMPERATURE=0.0
TYCHE_SENTIMENT_AZURE_MAX_RETRIES=5
TYCHE_SENTIMENT_AZURE_TIMEOUT=60
TYCHE_SENTIMENT_AZURE_MAX_WORKERS=8
# Optional: override the financial-sentiment system prompt sent with every scoring
# call (e.g. to A/B a prompt variant). Leave unset to use the built-in default in
# tyche/news/config.py (_DEFAULT_AZURE_SYSTEM_PROMPT). mistral_7b_instruct and
# llama2_13b_chat default to this same prompt (see their own *_SYSTEM_PROMPT below).
# TYCHE_SENTIMENT_AZURE_SYSTEM_PROMPT=

# ── finbert (local HF sequence-classification checkpoint, no API call) ──────
TYCHE_SENTIMENT_FINBERT_NAME=ProsusAI/finbert
TYCHE_SENTIMENT_FINBERT_REVISION=main
# device: auto | cpu | cuda | cuda:N | mps (auto picks CUDA > MPS > CPU)
TYCHE_SENTIMENT_FINBERT_DEVICE=auto
TYCHE_SENTIMENT_FINBERT_BATCH_SIZE=16
# Classification-head output order — index i must be the class named labels[i].
TYCHE_SENTIMENT_FINBERT_LABELS=positive,negative,neutral

# ── mistral_7b_instruct (local OpenAI-compatible endpoint, e.g. vLLM) ───────
# Served by docker-compose.sentiment-llms.yml at the repo root: an AWQ-quantized,
# bf16-compute Mistral-7B-Instruct checkpoint behind vLLM's OpenAI-compatible API.
# `docker compose -f docker-compose.sentiment-llms.yml up -d mistral` before
# adding mistral_7b_instruct to TYCHE_SENTIMENT_BACKENDS.
TYCHE_SENTIMENT_MISTRAL_BASE_URL=http://localhost:8001/v1
# Must match the server's --served-model-name in the compose file.
TYCHE_SENTIMENT_MISTRAL_MODEL=mistral-7b-instruct
# The OpenAI client requires a non-empty key even though vLLM doesn't check one by
# default; set a real key if the server is put behind auth.
TYCHE_SENTIMENT_MISTRAL_API_KEY=not-needed
TYCHE_SENTIMENT_MISTRAL_TEMPERATURE=0.0
TYCHE_SENTIMENT_MISTRAL_MAX_RETRIES=5
TYCHE_SENTIMENT_MISTRAL_TIMEOUT=60
TYCHE_SENTIMENT_MISTRAL_MAX_WORKERS=8
# Optional: override the fixed system prompt sent with every scoring call — same
# role/procedure as TYCHE_SENTIMENT_AZURE_SYSTEM_PROMPT. Leave unset to use the
# built-in default in tyche/news/config.py (_DEFAULT_MISTRAL_SYSTEM_PROMPT), which
# is the same prompt gpt4o_mini uses.
# TYCHE_SENTIMENT_MISTRAL_SYSTEM_PROMPT=

# ── llama2_13b_chat (local OpenAI-compatible endpoint, e.g. vLLM) ───────────
# Served by docker-compose.sentiment-llms.yml at the repo root: an AWQ-quantized,
# bf16-compute Llama-2-13B-chat checkpoint behind vLLM's OpenAI-compatible API.
# The underlying checkpoint is gated on the Hub — accept its license and set
# HF_TOKEN above, then `docker compose -f docker-compose.sentiment-llms.yml up -d
# llama2` before adding llama2_13b_chat to TYCHE_SENTIMENT_BACKENDS.
TYCHE_SENTIMENT_LLAMA2_BASE_URL=http://localhost:8002/v1
# Must match the server's --served-model-name in the compose file.
TYCHE_SENTIMENT_LLAMA2_MODEL=llama2-13b-chat
TYCHE_SENTIMENT_LLAMA2_API_KEY=not-needed
TYCHE_SENTIMENT_LLAMA2_TEMPERATURE=0.0
TYCHE_SENTIMENT_LLAMA2_MAX_RETRIES=5
TYCHE_SENTIMENT_LLAMA2_TIMEOUT=60
TYCHE_SENTIMENT_LLAMA2_MAX_WORKERS=8
# Optional: override Llama-2's concise, classification-focused system prompt.
# Leave unset to use the built-in _DEFAULT_LLAMA2_SYSTEM_PROMPT.
# TYCHE_SENTIMENT_LLAMA2_SYSTEM_PROMPT=

# ── Neutralizer ──────────────────────────────────────────────────────────────
TYCHE_NEUTRALIZER_ENTITY_PRIOR_PATH=data/output/entity_prior.json
TYCHE_NEUTRALIZER_ROLLING_WINDOW_DAYS=60
TYCHE_NEUTRALIZER_MIN_EVENTS=10
TYCHE_NEUTRALIZER_SHRINKAGE_K=20.0
TYCHE_NEUTRALIZER_WINSOR_LO=0.01
TYCHE_NEUTRALIZER_WINSOR_HI=0.99
TYCHE_NEUTRALIZER_STD_FLOOR=0.000001
TYCHE_NEUTRALIZER_GROUP_MIN_MEMBERS=3

# ── Auditor ──────────────────────────────────────────────────────────────────
TYCHE_AUDITOR_BASELINE_PATH=data/output/baseline.json
TYCHE_AUDITOR_PSI_THRESHOLD=0.10
TYCHE_AUDITOR_SAME_SIGN_ALERT=0.80
# JSON array of {text, expect} where expect ∈ {pos, neg, neu}
TYCHE_AUDITOR_SANITY_SENTENCES=[{"text":"revenues increased significantly","expect":"pos"},{"text":"the company reported a loss","expect":"neg"},{"text":"the meeting was held on Tuesday","expect":"neu"},{"text":"profit beat expectations and the stock surged","expect":"pos"},{"text":"shares tumbled after the profit warning","expect":"neg"}]

# ── Dask ─────────────────────────────────────────────────────────────────────
TYCHE_DASK_BLOCKSIZE=128MB
TYCHE_DASK_NPARTITIONS=4

# ══ Portfolio pipeline (tyche.portfolio.*) ════════════════════════════════════
# Defaults target the data actually on disk (prices cover 2023-10-02 ->
# 2024-12-31, 5 assets). The CLI (`uv run python -m tyche.portfolio.run`) also
# exposes --holding(s)/--lookback/--transaction-cost-bps, which override these
# per invocation via dataclasses.replace() without touching the environment.

# ── Paths ────────────────────────────────────────────────────────────────────
# Relative paths resolve against the repo root; absolute paths override outright.
TYCHE_PORTFOLIO_PATHS_NEWS_SENTIMENT=data/output/news_sentiment.parquet
# Long format: symbol, ticker, date, open, high, low, close, adj_close, volume.
# Built from the per-ticker directory by ./scripts/merge_rl2k_ohlcv.sh
TYCHE_PORTFOLIO_PATHS_DAILY_OHLCV=data/rl2k/ohlcv.parquet
# Portfolio-run and model-training artifacts; a target-distribution subdirectory
# (benchmark/student_t, benchmark/gaussian, ...) is appended automatically.
TYCHE_PORTFOLIO_PATHS_ARTIFACTS=benchmark
TYCHE_PORTFOLIO_PATHS_NEWS_EMBEDDING_CACHE=.cache/news_embedding_cache.npz

# ── Split (strictly chronological, no shuffling) ────────────────────────────
TYCHE_PORTFOLIO_SPLIT_IN_SAMPLE_START=2023-10-02
TYCHE_PORTFOLIO_SPLIT_IN_SAMPLE_END=2024-12-31
# First TRAIN_FRACTION of in-sample trading days train, the remainder validate.
TYCHE_PORTFOLIO_SPLIT_TRAIN_FRACTION=0.8
# Everything from TEST_START onward is the genuine out-of-sample backtest period.
TYCHE_PORTFOLIO_SPLIT_TEST_START=2025-01-01
TYCHE_PORTFOLIO_SPLIT_TEST_END=2025-12-31

# ── Window ───────────────────────────────────────────────────────────────────
TYCHE_PORTFOLIO_WINDOW_LOOKBACK=30
TYCHE_PORTFOLIO_WINDOW_HOLDING=5
# Must be >= HOLDING; trading days dropped after each split boundary.
TYCHE_PORTFOLIO_WINDOW_EMBARGO=5

# ── Universe (which assets form the cross-section) ─────────────────────────
# The price file has ~1.6k constituents, but the model predicts an NxN covariance
# and Choleskys it every forward pass, so cost grows as N^3 — at N=1584 a single
# batch's covariance tensor is ~320 MB. The universe is therefore capped at the
# most liquid names that have full price history AND news coverage.
TYCHE_PORTFOLIO_UNIVERSE_SIZE=50
# Require a complete price series, so the covariance is estimated on a
# rectangular panel rather than one whose membership changes day to day.
TYCHE_PORTFOLIO_UNIVERSE_REQUIRE_FULL_HISTORY=true
# Drop names below this median dollar volume before ranking (0 = no floor).
TYCHE_PORTFOLIO_UNIVERSE_MIN_DOLLAR_VOLUME=0
# Optional explicit list; bypasses the liquidity ranking when set.
# TYCHE_PORTFOLIO_UNIVERSE_SYMBOLS=ANF,CVNA,ELF

# ── Daily feature branch ─────────────────────────────────────────────────────
TYCHE_PORTFOLIO_DAILY_VOL_WINDOW=20
TYCHE_PORTFOLIO_DAILY_MOM_WINDOWS=5,20
TYCHE_PORTFOLIO_DAILY_RSI_WINDOW=14
TYCHE_PORTFOLIO_DAILY_ATR_WINDOW=14
TYCHE_PORTFOLIO_DAILY_ZSCORE_WINDOW=20

# ── News feature branch (portfolio-side story clustering) ───────────────────
TYCHE_PORTFOLIO_NEWS_DEDUP_ENABLED=true
TYCHE_PORTFOLIO_NEWS_DEDUP_LOOKBACK_DAYS=30
TYCHE_PORTFOLIO_NEWS_DEDUP_SIMILARITY_THRESHOLD=0.90
# device: auto | cpu | cuda | cuda:N | mps (auto picks CUDA > MPS > CPU)
TYCHE_PORTFOLIO_NEWS_DEDUP_DEVICE=auto
TYCHE_PORTFOLIO_NEWS_DEDUP_SIMILARITY_BATCH_SIZE=1024

# ── Predictive model architecture ───────────────────────────────────────────
TYCHE_PORTFOLIO_MODEL_CONV_CHANNELS=32
TYCHE_PORTFOLIO_MODEL_KERNEL_SIZE=3
TYCHE_PORTFOLIO_MODEL_DROPOUT=0.2
TYCHE_PORTFOLIO_MODEL_HIDDEN_DIM=64
# Low-rank factor width for the aleatoric covariance Sigma = LL^T + diag(d).
TYCHE_PORTFOLIO_MODEL_COV_RANK=2
TYCHE_PORTFOLIO_MODEL_COV_EPS=0.0001
# sequence_encoder: lstm | attention
TYCHE_PORTFOLIO_MODEL_SEQUENCE_ENCODER=lstm

# ── Model training ───────────────────────────────────────────────────────────
TYCHE_PORTFOLIO_TRAIN_EPOCHS=40
TYCHE_PORTFOLIO_TRAIN_BATCH_SIZE=32
TYCHE_PORTFOLIO_TRAIN_LR=0.001
TYCHE_PORTFOLIO_TRAIN_WEIGHT_DECAY=0.00001
# target_distribution: gaussian | student_t
TYCHE_PORTFOLIO_TRAIN_TARGET_DISTRIBUTION=student_t
# Degrees of freedom for the Student-t target; must be > 2 for finite covariance.
TYCHE_PORTFOLIO_TRAIN_STUDENT_T_DF=5.0
# Stochastic forward passes at prediction time that yield epistemic covariance.
TYCHE_PORTFOLIO_TRAIN_MC_DROPOUT_SAMPLES=50
TYCHE_PORTFOLIO_TRAIN_GRAD_CLIP=1.0
# Early-stopping patience on validation NLL.
TYCHE_PORTFOLIO_TRAIN_PATIENCE=8
TYCHE_PORTFOLIO_TRAIN_SEED=7
# device: auto | cpu | cuda | mps (auto picks CUDA > MPS > CPU)
TYCHE_PORTFOLIO_TRAIN_DEVICE=auto

# ── Allocation (Black-Litterman, risk-based, MVO, backtest) ─────────────────
TYCHE_PORTFOLIO_ALLOC_BL_TAU=0.05
TYCHE_PORTFOLIO_ALLOC_BL_RISK_AVERSION=2.5
TYCHE_PORTFOLIO_ALLOC_COV_SHRINKAGE=0.3
# Per-asset weight cap, constrained MVO only.
TYCHE_PORTFOLIO_ALLOC_MAX_WEIGHT=0.40
# Optional L1 turnover term in the MVO objective.
TYCHE_PORTFOLIO_ALLOC_TURNOVER_PENALTY=0.0
TYCHE_PORTFOLIO_ALLOC_TRANSACTION_COST_BPS=10.0
TYCHE_PORTFOLIO_ALLOC_SLIPPAGE_BPS=5.0
# Convert predicted log-return moments to arithmetic-return moments (exact
# lognormal transform) before allocation, matching what BL/MVO/cost model assume.
TYCHE_PORTFOLIO_ALLOC_CONVERT_TO_SIMPLE_RETURNS=true
# cost_model: round_trip | linear
TYCHE_PORTFOLIO_ALLOC_COST_MODEL=round_trip
TYCHE_PORTFOLIO_ALLOC_RISK_PARITY_MAX_ITER=500
TYCHE_PORTFOLIO_ALLOC_RISK_PARITY_TOL=0.0000000001
# Hierarchical risk parity: scipy linkage method on the correlation distance.
TYCHE_PORTFOLIO_ALLOC_HRP_LINKAGE=single
